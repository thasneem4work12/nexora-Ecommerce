// NEXORA Commerce — PostgreSQL Database Schema
// Phase 1: Authentication & Foundational Core Models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  MANAGER
  OWNER
  SUPERADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions           Session[]
  accounts           Account[]
  carts              Cart[]
  inventoryMovements InventoryMovement[]
  orders             Order[]
  addresses          Address[]
  returnRequests     ReturnRequest[]     @relation("UserReturns")
  reviewedReturns    ReturnRequest[]     @relation("ReviewedReturns")
  supportTickets     SupportTicket[]     @relation("UserTickets")
  assignedTickets    SupportTicket[]     @relation("AssignedTickets")
  ticketMessages     TicketMessage[]
  notifications      Notification[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?   @db.Text
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("categories")
}

model Product {
  id               String           @id @default(cuid())
  title            String
  slug             String           @unique
  description      String           @db.Text
  category         String
  categoryId       String?
  categoryRef      Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  basePriceInCents Int
  featured         Boolean          @default(false)
  published        Boolean          @default(true)
  isArchived       Boolean          @default(false)
  archivedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  variants         ProductVariant[]
  images           ProductImage[]
  orderItems       OrderItem[]

  @@index([category])
  @@index([categoryId])
  @@index([published])
  @@index([featured])
  @@index([isArchived])
  @@index([isArchived, published])
  @@index([published, featured])
  @@index([published, category])
  @@index([basePriceInCents])
  @@map("products")
}

model ProductVariant {
  id                 String              @id @default(cuid())
  productId          String
  sku                String              @unique
  title              String
  size               String?
  color              String?
  priceInCents       Int
  stock              Int                 @default(0)
  lowStockThreshold  Int                 @default(5)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems          CartItem[]
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]
  stockReservations  StockReservation[]

  @@index([productId])
  @@index([priceInCents])
  @@index([stock])
  @@index([isActive])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

model Cart {
  id           String     @id @default(cuid())
  userId       String?
  sessionToken String?    @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items        CartItem[]

  @@map("carts")
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

enum InventoryMovementType {
  RESTOCK
  ADJUSTMENT
  DAMAGED
  RETURN
  MANUAL_CORRECTION
  RESERVATION
  RELEASE
}

model InventoryMovement {
  id             String                 @id @default(cuid())
  variantId      String
  quantityChange Int
  previousStock  Int
  newStock       Int
  type           InventoryMovementType  @default(MANUAL_CORRECTION)
  reason         String?                @db.Text
  reference      String?
  userId         String?
  createdAt      DateTime               @default(now())

  variant        ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  user           User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([variantId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("inventory_movements")
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum StockReservationStatus {
  PENDING
  CONFIRMED
  RELEASED
  EXPIRED
}

enum ShipmentStatus {
  PENDING
  PROCESSING
  PACKED
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum RefundStatus {
  NONE
  PENDING_MANUAL_REVIEW
  PROCESSED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationType {
  ORDER_PLACED
  PAYMENT_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  CANCELLATION_DECISION
  RETURN_DECISION
  SUPPORT_TICKET_REPLY
  GENERAL
}

enum DeliveryStatus {
  QUEUED
  SENT
  FAILED
}

model Address {
  id              String   @id @default(cuid())
  userId          String?
  firstName       String
  lastName        String
  company         String?
  addressLine1    String
  addressLine2    String?
  city            String
  stateOrProvince String?
  postalCode      String
  country         String
  phone           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  shippingOrders  Order[]  @relation("OrderShippingAddress")
  billingOrders   Order[]  @relation("OrderBillingAddress")

  @@index([userId])
  @@map("addresses")
}

model Order {
  id                      String             @id @default(cuid())
  orderNumber             String             @unique
  userId                  String?
  guestEmail              String?
  guestName               String?
  status                  OrderStatus        @default(PENDING)
  fulfillmentStatus       FulfillmentStatus  @default(UNFULFILLED)
  currency                String             @default("USD")
  subtotalInCents         Int
  shippingInCents         Int                @default(0)
  taxInCents              Int                @default(0)
  discountInCents         Int                @default(0)
  totalInCents            Int
  paymentStatus           PaymentStatus      @default(UNPAID)
  shippingAddressId       String?
  billingAddressId        String?
  shippingMethod          String             @default("STANDARD")
  notes                   String?            @db.Text
  cancelReason            String?
  cancelledAt             DateTime?
  cancellationRequested   Boolean            @default(false)
  cancellationReason      String?
  cancellationRequestedAt DateTime?
  cancellationRequestedBy String?            // "CUSTOMER" | "STAFF"
  refundRequired          Boolean            @default(false)
  refundAmountInCents     Int?
  refundReason            String?
  refundedAt              DateTime?
  paidAt                  DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  user                    User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  shippingAddress         Address?           @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddress          Address?           @relation("OrderBillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  items                   OrderItem[]
  payments                Payment[]
  shipments               Shipment[]
  stockReservations       StockReservation[]
  returnRequests          ReturnRequest[]
  supportTickets          SupportTicket[]
  notifications           Notification[]

  @@index([userId])
  @@index([status])
  @@index([fulfillmentStatus])
  @@index([paymentStatus])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  productId       String?
  variantId       String?
  productTitle    String
  variantTitle    String
  sku             String
  imageUrl        String?
  priceInCents    Int
  quantity        Int
  subtotalInCents Int
  createdAt       DateTime        @default(now())

  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returnRequests  ReturnRequest[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@index([sku])
  @@map("order_items")
}

model Payment {
  id                String         @id @default(cuid())
  orderId           String
  provider          String         // "MOCK", "PAYHERE", "STRIPE", etc.
  providerPaymentId String?
  status            PaymentStatus  @default(PENDING)
  amountInCents     Int
  currency          String         @default("USD")
  paymentMethod     String?        // "CREDIT_CARD", "DEBIT_CARD", "BANK_TRANSFER"
  cardBrand         String?        // e.g. "Visa", "Mastercard" (NEVER store full card numbers)
  cardLast4         String?        // e.g. "4242"
  errorMessage      String?
  paidAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events            PaymentEvent[]

  @@index([orderId])
  @@index([providerPaymentId])
  @@index([status])
  @@map("payments")
}

model PaymentEvent {
  id        String   @id @default(cuid())
  paymentId String?
  orderId   String?
  provider  String
  eventType String
  eventId   String?  @unique // Idempotency key for provider webhook deduplication
  payload   String   @db.Text
  status    String   @default("PROCESSED")
  error     String?
  createdAt DateTime @default(now())

  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([eventId])
  @@index([provider])
  @@map("payment_events")
}

model StockReservation {
  id          String                 @id @default(cuid())
  orderId     String
  variantId   String
  quantity    Int
  status      StockReservationStatus @default(PENDING)
  expiresAt   DateTime
  confirmedAt DateTime?
  releasedAt  DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  order       Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([variantId])
  @@index([status])
  @@index([expiresAt])
  @@map("stock_reservations")
}

model Shipment {
  id                String         @id @default(cuid())
  orderId           String
  trackingNumber    String?
  carrier           String?        // e.g. "DHL Express", "FedEx", "Boutique Courier"
  trackingUrl       String?        // Secure validated tracking link
  status            ShipmentStatus @default(PENDING)
  shippedAt         DateTime?
  dispatchedAt      DateTime?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([trackingNumber])
  @@index([status])
  @@map("shipments")
}

model ReturnRequest {
  id                  String       @id @default(cuid())
  returnNumber        String       @unique
  orderId             String
  orderItemId         String?
  userId              String
  requestedQuantity   Int          @default(1)
  reason              String       @db.Text
  status              ReturnStatus @default(PENDING)
  refundAmountInCents Int?
  refundStatus        RefundStatus @default(NONE)
  adminNotes          String?      @db.Text
  resolutionNotes     String?      @db.Text
  reviewedByUserId    String?
  reviewedAt          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  order               Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem           OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  user                User         @relation("UserReturns", fields: [userId], references: [id], onDelete: Cascade)
  reviewedByUser      User?        @relation("ReviewedReturns", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([refundStatus])
  @@index([returnNumber])
  @@map("return_requests")
}

model SupportTicket {
  id              String         @id @default(cuid())
  ticketNumber    String         @unique
  userId          String
  orderId         String?
  subject         String
  description     String         @db.Text
  status          TicketStatus   @default(OPEN)
  priority        TicketPriority @default(NORMAL)
  assignedStaffId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User           @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  assignedStaff   User?          @relation("AssignedTickets", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  messages        TicketMessage[]

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([priority])
  @@index([ticketNumber])
  @@map("support_tickets")
}

model TicketMessage {
  id             String        @id @default(cuid())
  ticketId       String
  senderId       String
  senderRole     Role          @default(CUSTOMER)
  message        String        @db.Text
  isInternalNote Boolean       @default(false)
  createdAt      DateTime      @default(now())

  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender         User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([senderId])
  @@map("ticket_messages")
}

model Notification {
  id             String           @id @default(cuid())
  userId         String
  orderId        String?
  ticketId       String?
  type           NotificationType @default(GENERAL)
  title          String
  message        String           @db.Text
  emailTo        String?
  emailSubject   String?
  emailBody      String?          @db.Text
  isRead         Boolean          @default(false)
  deliveryStatus DeliveryStatus   @default(SENT)
  deliveryError  String?
  deliveredAt    DateTime?
  createdAt      DateTime         @default(now())

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  order          Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orderId])
  @@index([type])
  @@index([isRead])
  @@map("notifications")
}

model StoreThemeConfig {
  id                  String   @id @default(cuid())
  businessId          String   @unique @default("default-store")
  activeThemeId       String   @default("editorial-luxury")
  storeName           String   @default("NEXORA")
  storeTagline        String   @default("Haute Couture")
  logoUrl             String?
  faviconUrl          String?
  contactEmail        String?  @default("concierge@nexoracommerce.com")
  contactPhone        String?  @default("+1 (800) 456-7890")
  announcementText    String?  @default("Complimentary Worldwide Delivery on Orders Over $150")
  announcementEnabled Boolean  @default(true)
  announcementLink    String?  @default("/products")
  primaryColor        String?
  secondaryColor      String?
  fontPreset          String   @default("default")
  headerConfig        Json?
  footerConfig        Json?
  homepageSections    Json?
  draftConfig         Json?
  publishedAt         DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([businessId])
  @@index([activeThemeId])
  @@map("store_theme_configs")
}



