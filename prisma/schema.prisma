// NEXORA Commerce — PostgreSQL Database Schema
// Phase 7: Multi-Tenant SaaS Architecture, Business Onboarding & Store Isolation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  MANAGER
  OWNER
  SUPERADMIN
}

enum BusinessRole {
  OWNER
  MANAGER
  STAFF
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
  ONBOARDING
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Business {
  id           String         @id @default(cuid())
  slug         String         @unique
  name         String
  type         String         @default("LUXURY_FASHION")
  status       BusinessStatus @default(ACTIVE)
  currency     String         @default("USD")
  contactEmail String?
  contactPhone String?
  description  String?        @db.Text
  isSuspended  Boolean        @default(false)
  suspendedAt  DateTime?
  suspensionReason String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  members              BusinessMember[]
  settings             BusinessSettings?
  themeConfig          StoreThemeConfig?
  invitations          BusinessInvitation[]
  auditLogs            BusinessAuditLog[]
  categories           Category[]
  products             Product[]
  orders               Order[]
  carts                Cart[]
  inventoryMovements   InventoryMovement[]
  stockReservations    StockReservation[]
  payments             Payment[]
  returnRequests       ReturnRequest[]
  supportTickets       SupportTicket[]
  notifications        Notification[]
  subscription         SaaSSubscription?
  saasInvoices         SaaSInvoice[]
  saasPayments         SaaSPayment[]
  saasBillingEvents    SaaSBillingEvent[]
  saasUsageRecords     SaaSUsageRecord[]
  saasPlanChanges      SaaSPlanChange[]
  saasBillingAuditLogs SaaSBillingAuditLog[]

  @@index([slug])
  @@index([status])
  @@index([isSuspended])
  @@map("businesses")
}

model BusinessMember {
  id         String       @id @default(cuid())
  businessId String
  userId     String
  role       BusinessRole @default(STAFF)
  title      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
  @@map("business_members")
}

model BusinessSettings {
  id                    String   @id @default(cuid())
  businessId            String   @unique
  payhereMerchantId     String?
  payhereMerchantSecret String?
  allowMockPayment      Boolean  @default(true)
  inventoryTracking     Boolean  @default(true)
  orderPrefix           String   @default("NXR")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_settings")
}

model BusinessInvitation {
  id          String           @id @default(cuid())
  businessId  String
  email       String
  role        BusinessRole     @default(STAFF)
  token       String           @unique
  invitedById String
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy   User             @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([email])
  @@index([token])
  @@map("business_invitations")
}

model BusinessAuditLog {
  id         String   @id @default(cuid())
  businessId String
  userId     String?
  action     String
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([userId])
  @@index([action])
  @@map("business_audit_logs")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions           Session[]
  accounts           Account[]
  carts              Cart[]
  inventoryMovements InventoryMovement[]
  orders             Order[]
  addresses          Address[]
  returnRequests     ReturnRequest[]      @relation("UserReturns")
  reviewedReturns    ReturnRequest[]      @relation("ReviewedReturns")
  supportTickets     SupportTicket[]      @relation("UserTickets")
  assignedTickets    SupportTicket[]      @relation("AssignedTickets")
  ticketMessages     TicketMessage[]
  notifications      Notification[]
  businessMembers      BusinessMember[]
  sentInvitations      BusinessInvitation[] @relation("SentInvitations")
  businessAuditLogs    BusinessAuditLog[]
  requestedPlanChanges SaaSPlanChange[]     @relation("RequestedPlanChanges")
  saasBillingAuditLogs SaaSBillingAuditLog[] @relation("SaaSBillingAuditLogs")

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

model Category {
  id          String   @id @default(cuid())
  businessId  String   @default("default-store")
  name        String
  slug        String
  description String?  @db.Text
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([businessId, slug])
  @@unique([businessId, name])
  @@index([businessId])
  @@map("categories")
}

model Product {
  id               String           @id @default(cuid())
  businessId       String           @default("default-store")
  title            String
  slug             String
  description      String           @db.Text
  category         String
  categoryId       String?
  categoryRef      Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  basePriceInCents Int
  featured         Boolean          @default(false)
  published        Boolean          @default(true)
  isArchived       Boolean          @default(false)
  archivedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  business         Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  variants         ProductVariant[]
  images           ProductImage[]
  orderItems       OrderItem[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([category])
  @@index([categoryId])
  @@index([published])
  @@index([featured])
  @@index([isArchived])
  @@index([businessId, published])
  @@index([businessId, isArchived])
  @@index([published, featured])
  @@index([published, category])
  @@index([basePriceInCents])
  @@map("products")
}

model ProductVariant {
  id                 String              @id @default(cuid())
  productId          String
  sku                String              @unique
  title              String
  size               String?
  color              String?
  priceInCents       Int
  stock              Int                 @default(0)
  lowStockThreshold  Int                 @default(5)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems          CartItem[]
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]
  stockReservations  StockReservation[]

  @@index([productId])
  @@index([priceInCents])
  @@index([stock])
  @@index([isActive])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

model Cart {
  id           String     @id @default(cuid())
  businessId   String     @default("default-store")
  userId       String?
  sessionToken String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items        CartItem[]

  @@unique([businessId, sessionToken])
  @@index([businessId])
  @@index([userId])
  @@map("carts")
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

enum InventoryMovementType {
  RESTOCK
  ADJUSTMENT
  DAMAGED
  RETURN
  MANUAL_CORRECTION
  RESERVATION
  RELEASE
  CANCELLATION
}

model InventoryMovement {
  id             String                @id @default(cuid())
  businessId     String                @default("default-store")
  variantId      String
  quantityChange Int
  previousStock  Int
  newStock       Int
  type           InventoryMovementType @default(MANUAL_CORRECTION)
  reason         String?               @db.Text
  reference      String?
  userId         String?
  createdAt      DateTime              @default(now())

  business       Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  variant        ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  user           User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([variantId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("inventory_movements")
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum StockReservationStatus {
  PENDING
  CONFIRMED
  RELEASED
  EXPIRED
}

enum ShipmentStatus {
  PENDING
  PROCESSING
  PACKED
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum RefundStatus {
  NONE
  PENDING_MANUAL_REVIEW
  PROCESSED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationType {
  ORDER_PLACED
  PAYMENT_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  CANCELLATION_DECISION
  RETURN_DECISION
  SUPPORT_TICKET_REPLY
  GENERAL
}

enum DeliveryStatus {
  QUEUED
  SENT
  FAILED
}

model Address {
  id              String   @id @default(cuid())
  userId          String?
  firstName       String
  lastName        String
  company         String?
  addressLine1    String
  addressLine2    String?
  city            String
  stateOrProvince String?
  postalCode      String
  country         String
  phone           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  shippingOrders  Order[]  @relation("OrderShippingAddress")
  billingOrders   Order[]  @relation("OrderBillingAddress")

  @@index([userId])
  @@map("addresses")
}

model Order {
  id                      String             @id @default(cuid())
  businessId              String             @default("default-store")
  orderNumber             String             @unique
  userId                  String?
  guestEmail              String?
  guestName               String?
  status                  OrderStatus        @default(PENDING)
  fulfillmentStatus       FulfillmentStatus  @default(UNFULFILLED)
  currency                String             @default("USD")
  subtotalInCents         Int
  shippingInCents         Int                @default(0)
  taxInCents              Int                @default(0)
  discountInCents         Int                @default(0)
  totalInCents            Int
  paymentStatus           PaymentStatus      @default(UNPAID)
  shippingAddressId       String?
  billingAddressId        String?
  shippingMethod          String             @default("STANDARD")
  notes                   String?            @db.Text
  cancelReason            String?
  cancelledAt             DateTime?
  cancellationRequested   Boolean            @default(false)
  cancellationReason      String?
  cancellationRequestedAt DateTime?
  cancellationRequestedBy String?
  refundRequired          Boolean            @default(false)
  refundAmountInCents     Int?
  refundReason            String?
  refundedAt              DateTime?
  paidAt                  DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  business                Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user                    User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  shippingAddress         Address?           @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddress          Address?           @relation("OrderBillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  items                   OrderItem[]
  payments                Payment[]
  shipments               Shipment[]
  stockReservations       StockReservation[]
  returnRequests          ReturnRequest[]
  supportTickets          SupportTicket[]
  notifications           Notification[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([userId])
  @@index([status])
  @@index([fulfillmentStatus])
  @@index([paymentStatus])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  productId       String?
  variantId       String?
  productTitle    String
  variantTitle    String
  sku             String
  imageUrl        String?
  priceInCents    Int
  quantity        Int
  subtotalInCents Int
  createdAt       DateTime        @default(now())

  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returnRequests  ReturnRequest[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@index([sku])
  @@map("order_items")
}

model Payment {
  id                String         @id @default(cuid())
  businessId        String         @default("default-store")
  orderId           String
  provider          String
  providerPaymentId String?
  status            PaymentStatus  @default(PENDING)
  amountInCents     Int
  currency          String         @default("USD")
  paymentMethod     String?
  cardBrand         String?
  cardLast4         String?
  errorMessage      String?
  paidAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  business          Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events            PaymentEvent[]

  @@index([businessId])
  @@index([orderId])
  @@index([providerPaymentId])
  @@index([status])
  @@map("payments")
}

model PaymentEvent {
  id         String   @id @default(cuid())
  businessId String?
  paymentId  String?
  orderId    String?
  provider   String
  eventType  String
  eventId    String?  @unique
  payload    String   @db.Text
  status     String   @default("PROCESSED")
  error      String?
  createdAt  DateTime @default(now())

  payment    Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([orderId])
  @@index([eventId])
  @@index([provider])
  @@map("payment_events")
}

model StockReservation {
  id          String                 @id @default(cuid())
  businessId  String                 @default("default-store")
  orderId     String
  variantId   String
  quantity    Int
  status      StockReservationStatus @default(PENDING)
  expiresAt   DateTime
  confirmedAt DateTime?
  releasedAt  DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  business    Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order       Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, status, expiresAt])
  @@index([orderId])
  @@index([variantId])
  @@index([status])
  @@index([expiresAt])
  @@map("stock_reservations")
}

model Shipment {
  id                String         @id @default(cuid())
  orderId           String
  trackingNumber    String?
  carrier           String?
  trackingUrl       String?
  status            ShipmentStatus @default(PENDING)
  shippedAt         DateTime?
  dispatchedAt      DateTime?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([trackingNumber])
  @@index([status])
  @@map("shipments")
}

model ReturnRequest {
  id                  String       @id @default(cuid())
  businessId          String       @default("default-store")
  returnNumber        String       @unique
  orderId             String
  orderItemId         String?
  userId              String
  requestedQuantity   Int          @default(1)
  reason              String       @db.Text
  status              ReturnStatus @default(PENDING)
  refundAmountInCents Int?
  refundStatus        RefundStatus @default(NONE)
  adminNotes          String?      @db.Text
  resolutionNotes     String?      @db.Text
  reviewedByUserId    String?
  reviewedAt          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  business            Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order               Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem           OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  user                User         @relation("UserReturns", fields: [userId], references: [id], onDelete: Cascade)
  reviewedByUser      User?        @relation("ReviewedReturns", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, status])
  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([refundStatus])
  @@index([returnNumber])
  @@map("return_requests")
}

model SupportTicket {
  id              String         @id @default(cuid())
  businessId      String         @default("default-store")
  ticketNumber    String         @unique
  userId          String
  orderId         String?
  subject         String
  description     String         @db.Text
  status          TicketStatus   @default(OPEN)
  priority        TicketPriority @default(NORMAL)
  assignedStaffId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user            User           @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  assignedStaff   User?          @relation("AssignedTickets", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  messages        TicketMessage[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([priority])
  @@index([ticketNumber])
  @@map("support_tickets")
}

model TicketMessage {
  id             String        @id @default(cuid())
  ticketId       String
  senderId       String
  senderRole     Role          @default(CUSTOMER)
  message        String        @db.Text
  isInternalNote Boolean       @default(false)
  createdAt      DateTime      @default(now())

  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender         User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([senderId])
  @@map("ticket_messages")
}

model Notification {
  id             String           @id @default(cuid())
  businessId     String?
  userId         String
  orderId        String?
  ticketId       String?
  type           NotificationType @default(GENERAL)
  title          String
  message        String           @db.Text
  emailTo        String?
  emailSubject   String?
  emailBody      String?          @db.Text
  isRead         Boolean          @default(false)
  deliveryStatus DeliveryStatus   @default(SENT)
  deliveryError  String?
  deliveredAt    DateTime?
  createdAt      DateTime         @default(now())

  business       Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  order          Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([userId])
  @@index([orderId])
  @@index([type])
  @@index([isRead])
  @@map("notifications")
}

model StoreThemeConfig {
  id                  String   @id @default(cuid())
  businessId          String   @unique @default("default-store")
  activeThemeId       String   @default("editorial-luxury")
  storeName           String   @default("NEXORA")
  storeTagline        String   @default("Haute Couture")
  logoUrl             String?
  faviconUrl          String?
  contactEmail        String?  @default("concierge@nexoracommerce.com")
  contactPhone        String?  @default("+1 (800) 456-7890")
  announcementText    String?  @default("Complimentary Worldwide Delivery on Orders Over $150")
  announcementEnabled Boolean  @default(true)
  announcementLink    String?  @default("/products")
  primaryColor        String?
  secondaryColor      String?
  fontPreset          String   @default("default")
  headerConfig        Json?
  footerConfig        Json?
  homepageSections    Json?
  draftConfig         Json?
  publishedAt         DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([activeThemeId])
  @@map("store_theme_configs")
}

// ==========================================
// Phase 8: SaaS Subscription & Plan Management Models
// ==========================================

enum SaaSBillingInterval {
  MONTHLY
  YEARLY
}

enum SaaSSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  SUSPENDED
}

enum SaaSInvoiceStatus {
  DRAFT
  OPEN
  PAID
  UNCOLLECTIBLE
  VOID
}

enum SaaSPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model SaaSPlan {
  id                     String             @id @default(cuid())
  code                   String             @unique
  name                   String
  description            String?            @db.Text
  isActive               Boolean            @default(true)
  isPublic               Boolean            @default(true)
  features               Json?
  maxProducts            Int                @default(50)
  maxStaff               Int                @default(2)
  maxStorageMb           Int                @default(1000)
  allowCustomThemes      Boolean            @default(false)
  allowAdvancedAnalytics Boolean            @default(false)
  allowPrioritySupport   Boolean            @default(false)
  trialDays              Int                @default(14)
  sortOrder              Int                @default(0)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  prices                 SaaSPlanPrice[]
  subscriptions          SaaSSubscription[]
  planChangesFrom        SaaSPlanChange[]   @relation("PlanChangeFrom")
  planChangesTo          SaaSPlanChange[]   @relation("PlanChangeTo")

  @@map("saas_plans")
}

model SaaSPlanPrice {
  id             String              @id @default(cuid())
  planId         String
  interval       SaaSBillingInterval
  currency       String              @default("USD")
  amountInCents  Int
  version        Int                 @default(1)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  plan           SaaSPlan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions  SaaSSubscription[]
  invoiceLines   SaaSInvoiceLine[]

  @@unique([planId, interval, version])
  @@index([planId])
  @@map("saas_plan_prices")
}

model SaaSSubscription {
  id                     String                 @id @default(cuid())
  businessId             String                 @unique
  planId                 String
  priceId                String
  status                 SaaSSubscriptionStatus @default(TRIALING)
  billingInterval        SaaSBillingInterval    @default(MONTHLY)
  currency               String                 @default("USD")
  trialStartsAt          DateTime?
  trialEndsAt            DateTime?
  currentPeriodStartsAt  DateTime               @default(now())
  currentPeriodEndsAt    DateTime
  cancelAtPeriodEnd      Boolean                @default(false)
  canceledAt             DateTime?
  cancelReason           String?
  endedAt                DateTime?
  provider               String                 @default("SIMULATED")
  providerSubscriptionId String?
  providerCustomerId     String?
  metadata               Json?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  business               Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan                   SaaSPlan               @relation(fields: [planId], references: [id])
  price                  SaaSPlanPrice          @relation(fields: [priceId], references: [id])
  invoices               SaaSInvoice[]
  payments               SaaSPayment[]
  billingEvents          SaaSBillingEvent[]
  usageRecords           SaaSUsageRecord[]
  planChanges            SaaSPlanChange[]

  @@index([planId])
  @@index([priceId])
  @@index([status])
  @@map("saas_subscriptions")
}

model SaaSInvoice {
  id                    String            @id @default(cuid())
  invoiceNumber         String            @unique
  subscriptionId        String
  businessId            String
  status                SaaSInvoiceStatus @default(OPEN)
  billingPeriodStartsAt DateTime
  billingPeriodEndsAt   DateTime
  subtotalInCents       Int
  taxInCents            Int               @default(0)
  discountInCents       Int               @default(0)
  totalInCents          Int
  currency              String            @default("USD")
  paidAt                DateTime?
  dueDate               DateTime
  pdfUrl                String?
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  subscription          SaaSSubscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  business              Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lines                 SaaSInvoiceLine[]
  payments              SaaSPayment[]

  @@index([subscriptionId])
  @@index([businessId])
  @@index([status])
  @@index([invoiceNumber])
  @@map("saas_invoices")
}

model SaaSInvoiceLine {
  id                 String         @id @default(cuid())
  invoiceId          String
  priceId            String?
  description        String
  quantity           Int            @default(1)
  unitAmountInCents  Int
  totalAmountInCents Int
  currency           String         @default("USD")
  createdAt          DateTime       @default(now())

  invoice            SaaSInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  price              SaaSPlanPrice? @relation(fields: [priceId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("saas_invoice_lines")
}

model SaaSPayment {
  id                 String            @id @default(cuid())
  subscriptionId     String
  invoiceId          String?
  businessId         String
  paymentNumber      String            @unique
  provider           String            @default("SIMULATED")
  providerPaymentId  String?
  amountInCents      Int
  currency           String            @default("USD")
  status             SaaSPaymentStatus @default(PENDING)
  errorMessage       String?
  metadata           Json?
  paidAt             DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  subscription       SaaSSubscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  invoice            SaaSInvoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  business           Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  billingEvents      SaaSBillingEvent[]

  @@index([subscriptionId])
  @@index([invoiceId])
  @@index([businessId])
  @@index([status])
  @@map("saas_payments")
}

model SaaSBillingEvent {
  id             String            @id @default(cuid())
  businessId     String
  subscriptionId String?
  paymentId      String?
  provider       String
  eventId        String            @unique
  eventType      String
  status         String            @default("PROCESSED")
  payload        String            @db.Text
  error          String?
  createdAt      DateTime          @default(now())

  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription   SaaSSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payment        SaaSPayment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([subscriptionId])
  @@index([paymentId])
  @@index([eventId])
  @@map("saas_billing_events")
}

model SaaSUsageRecord {
  id             String           @id @default(cuid())
  businessId     String
  subscriptionId String
  metric         String
  currentValue   Int              @default(0)
  limitValue     Int              @default(0)
  recordedAt     DateTime         @default(now())

  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription   SaaSSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([businessId, metric])
  @@index([subscriptionId])
  @@map("saas_usage_records")
}

model SaaSPlanChange {
  id                     String           @id @default(cuid())
  subscriptionId         String
  businessId             String
  fromPlanId             String
  toPlanId               String
  requestedByUserId      String?
  changeType             String
  effectiveDate          DateTime
  prorationAmountInCents Int              @default(0)
  reason                 String?
  createdAt              DateTime         @default(now())

  subscription           SaaSSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  business               Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fromPlan               SaaSPlan         @relation("PlanChangeFrom", fields: [fromPlanId], references: [id])
  toPlan                 SaaSPlan         @relation("PlanChangeTo", fields: [toPlanId], references: [id])
  requestedBy            User?            @relation("RequestedPlanChanges", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([subscriptionId])
  @@index([businessId])
  @@map("saas_plan_changes")
}

model SaaSBillingAuditLog {
  id         String    @id @default(cuid())
  businessId String?
  userId     String?
  action     String
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  user       User?     @relation("SaaSBillingAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([userId])
  @@index([action])
  @@map("saas_billing_audit_logs")
}

