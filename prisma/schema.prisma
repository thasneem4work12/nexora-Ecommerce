// NEXORA Commerce — PostgreSQL Database Schema
// Phase 1: Authentication & Foundational Core Models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  MANAGER
  OWNER
  SUPERADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions           Session[]
  accounts           Account[]
  carts              Cart[]
  inventoryMovements InventoryMovement[]
  orders             Order[]
  addresses          Address[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?   @db.Text
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("categories")
}

model Product {
  id               String           @id @default(cuid())
  title            String
  slug             String           @unique
  description      String           @db.Text
  category         String
  categoryId       String?
  categoryRef      Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  basePriceInCents Int
  featured         Boolean          @default(false)
  published        Boolean          @default(true)
  isArchived       Boolean          @default(false)
  archivedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  variants         ProductVariant[]
  images           ProductImage[]
  orderItems       OrderItem[]

  @@index([category])
  @@index([categoryId])
  @@index([published])
  @@index([featured])
  @@index([isArchived])
  @@index([isArchived, published])
  @@index([published, featured])
  @@index([published, category])
  @@index([basePriceInCents])
  @@map("products")
}

model ProductVariant {
  id                 String              @id @default(cuid())
  productId          String
  sku                String              @unique
  title              String
  size               String?
  color              String?
  priceInCents       Int
  stock              Int                 @default(0)
  lowStockThreshold  Int                 @default(5)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems          CartItem[]
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]
  stockReservations  StockReservation[]

  @@index([productId])
  @@index([priceInCents])
  @@index([stock])
  @@index([isActive])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

model Cart {
  id           String     @id @default(cuid())
  userId       String?
  sessionToken String?    @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items        CartItem[]

  @@map("carts")
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

enum InventoryMovementType {
  RESTOCK
  ADJUSTMENT
  DAMAGED
  RETURN
  MANUAL_CORRECTION
  RESERVATION
  RELEASE
}

model InventoryMovement {
  id             String                 @id @default(cuid())
  variantId      String
  quantityChange Int
  previousStock  Int
  newStock       Int
  type           InventoryMovementType  @default(MANUAL_CORRECTION)
  reason         String?                @db.Text
  reference      String?
  userId         String?
  createdAt      DateTime               @default(now())

  variant        ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  user           User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([variantId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("inventory_movements")
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum StockReservationStatus {
  PENDING
  CONFIRMED
  RELEASED
  EXPIRED
}

enum ShipmentStatus {
  PENDING
  PROCESSING
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

model Address {
  id              String   @id @default(cuid())
  userId          String?
  firstName       String
  lastName        String
  company         String?
  addressLine1    String
  addressLine2    String?
  city            String
  stateOrProvince String?
  postalCode      String
  country         String
  phone           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  shippingOrders  Order[]  @relation("OrderShippingAddress")
  billingOrders   Order[]  @relation("OrderBillingAddress")

  @@index([userId])
  @@map("addresses")
}

model Order {
  id                 String             @id @default(cuid())
  orderNumber        String             @unique
  userId             String?
  guestEmail         String?
  guestName          String?
  status             OrderStatus        @default(PENDING)
  currency           String             @default("USD")
  subtotalInCents    Int
  shippingInCents    Int                @default(0)
  taxInCents         Int                @default(0)
  discountInCents    Int                @default(0)
  totalInCents       Int
  paymentStatus      PaymentStatus      @default(UNPAID)
  shippingAddressId  String?
  billingAddressId   String?
  shippingMethod     String             @default("STANDARD")
  notes              String?            @db.Text
  cancelReason       String?
  cancelledAt        DateTime?
  paidAt             DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  shippingAddress    Address?           @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddress     Address?           @relation("OrderBillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  payments           Payment[]
  shipments          Shipment[]
  stockReservations  StockReservation[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  productId       String?
  variantId       String?
  productTitle    String
  variantTitle    String
  sku             String
  imageUrl        String?
  priceInCents    Int
  quantity        Int
  subtotalInCents Int
  createdAt       DateTime        @default(now())

  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@index([sku])
  @@map("order_items")
}

model Payment {
  id                String         @id @default(cuid())
  orderId           String
  provider          String         // "MOCK", "PAYHERE", "STRIPE", etc.
  providerPaymentId String?
  status            PaymentStatus  @default(PENDING)
  amountInCents     Int
  currency          String         @default("USD")
  paymentMethod     String?        // "CREDIT_CARD", "DEBIT_CARD", "BANK_TRANSFER"
  cardBrand         String?        // e.g. "Visa", "Mastercard" (NEVER store full card numbers)
  cardLast4         String?        // e.g. "4242"
  errorMessage      String?
  paidAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events            PaymentEvent[]

  @@index([orderId])
  @@index([providerPaymentId])
  @@index([status])
  @@map("payments")
}

model PaymentEvent {
  id        String   @id @default(cuid())
  paymentId String?
  orderId   String?
  provider  String
  eventType String
  eventId   String?  @unique // Idempotency key for provider webhook deduplication
  payload   String   @db.Text
  status    String   @default("PROCESSED")
  error     String?
  createdAt DateTime @default(now())

  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([eventId])
  @@index([provider])
  @@map("payment_events")
}

model StockReservation {
  id          String                 @id @default(cuid())
  orderId     String
  variantId   String
  quantity    Int
  status      StockReservationStatus @default(PENDING)
  expiresAt   DateTime
  confirmedAt DateTime?
  releasedAt  DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  order       Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([variantId])
  @@index([status])
  @@index([expiresAt])
  @@map("stock_reservations")
}

model Shipment {
  id                String         @id @default(cuid())
  orderId           String
  trackingNumber    String?
  carrier           String?        // e.g. "DHL Express", "FedEx", "Boutique Courier"
  status            ShipmentStatus @default(PENDING)
  shippedAt         DateTime?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([trackingNumber])
  @@index([status])
  @@map("shipments")
}


