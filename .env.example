# ==============================================================================
# NEXORA Commerce — Environment Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=development

# Database Connection (PostgreSQL via Docker Compose)
DATABASE_URL="postgresql://nexora:nexora_password@localhost:5432/nexora_db?schema=public"

# Better Auth Secret & Base URL
BETTER_AUTH_SECRET="nexora_development_session_secret_key_at_least_32_characters_long"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storefront Settings
NEXT_PUBLIC_STORE_NAME="NEXORA Haute Couture"
NEXT_PUBLIC_STORE_TAGLINE="Exquisite Craftsmanship & Modern Luxury"
NEXT_PUBLIC_STORE_CURRENCY="USD"

# Phase 4 Payments Configuration
ALLOW_MOCK_PAYMENT="false"
MOCK_PAYMENT_SECRET="change_me_to_a_secure_random_string"
PAYHERE_SANDBOX="true"
PAYHERE_MERCHANT_ID="your_payhere_merchant_id"
PAYHERE_MERCHANT_SECRET="your_payhere_merchant_secret"

# Phase 8 SaaS Subscription Billing Configuration
SAAS_BILLING_WEBHOOK_SECRET="your_saas_billing_webhook_secret_at_least_32_characters"

