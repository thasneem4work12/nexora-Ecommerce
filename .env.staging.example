# ==============================================================================
# NEXORA Commerce — Private Staging Environment Template (.env.staging)
# ==============================================================================

# Node Environment (staging runs production-like builds with mock safety)
NODE_ENV=staging

# Staging Database (Isolated PostgreSQL container on port 5433 or internal docker network)
DATABASE_URL="postgresql://nexora_staging:nexora_staging_pass@postgres-staging:5432/nexora_staging_db?schema=public"

# Better Auth Session Secret & Staging Base URL
BETTER_AUTH_SECRET="nexora_staging_secret_key_at_least_32_characters_long_for_auth"
BETTER_AUTH_URL="http://localhost:3005"
NEXT_PUBLIC_APP_URL="http://localhost:3005"

# Staging Storefront Defaults
NEXT_PUBLIC_STORE_NAME="NEXORA Staging Atelier"
NEXT_PUBLIC_STORE_TAGLINE="Private Quality Assurance & Pilot Testing"
NEXT_PUBLIC_STORE_CURRENCY="USD"

# Payments (Simulated & Sandbox Only)
ALLOW_MOCK_PAYMENT="true"
MOCK_PAYMENT_SECRET="staging_mock_payment_secret_random_secure_32_chars"
PAYHERE_SANDBOX="true"
PAYHERE_MERCHANT_ID="staging_sandbox_merchant_id"
PAYHERE_MERCHANT_SECRET="staging_sandbox_merchant_secret"

# SaaS Subscription Webhook Simulation Secret
SAAS_BILLING_WEBHOOK_SECRET="staging_saas_webhook_secret_key_minimum_32_chars"

# File & Image Storage Configuration
STORAGE_DRIVER=local
UPLOAD_DIR=/app/uploads
