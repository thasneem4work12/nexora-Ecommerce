# ==============================================================================
# NEXORA Commerce — Production Environment Template (.env.production)
# ==============================================================================
# CAUTION: Replace all placeholders with secure random credentials from your production secrets vault.
# NEVER commit production .env files or credentials to Git.

NODE_ENV=production

# Production Database (Managed RDS / Supabase with Connection Pooling)
DATABASE_URL="postgresql://nexora_prod_user:SECURE_STRONG_PASSWORD@prod-db.internal:5432/nexora_production?sslmode=require&connection_limit=20&pool_timeout=15"

# Better Auth Session Secret (Must be >= 32 cryptographically random characters)
BETTER_AUTH_SECRET="REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_64_CHAR_SECRET"
BETTER_AUTH_URL="https://app.nexoracommerce.com"
NEXT_PUBLIC_APP_URL="https://app.nexoracommerce.com"

# Storefront Branding Defaults
NEXT_PUBLIC_STORE_NAME="NEXORA Haute Couture"
NEXT_PUBLIC_STORE_TAGLINE="Exquisite Craftsmanship & Modern Luxury"
NEXT_PUBLIC_STORE_CURRENCY="USD"

# Payments Configuration (STRICT PRODUCTION SAFETY: MOCK PAYMENTS STRICTLY FORBIDDEN)
ALLOW_MOCK_PAYMENT="false"
MOCK_PAYMENT_SECRET=""
PAYHERE_SANDBOX="false"
PAYHERE_MERCHANT_ID="PRODUCTION_APPROVED_PAYHERE_MERCHANT_ID"
PAYHERE_MERCHANT_SECRET="PRODUCTION_APPROVED_PAYHERE_MERCHANT_SECRET"

# SaaS Billing Webhook Secret (HMAC-SHA256 verification)
SAAS_BILLING_WEBHOOK_SECRET="REPLACE_WITH_PRODUCTION_SAAS_WEBHOOK_SECRET_MIN_32_CHARS"

# Object Storage Configuration (S3 / Cloudflare R2 / AWS S3)
STORAGE_DRIVER=s3
UPLOAD_DIR="/app/uploads"
S3_BUCKET="nexora-commerce-production-assets"
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID="PRODUCTION_IAM_ACCESS_KEY_ID"
S3_SECRET_ACCESS_KEY="PRODUCTION_IAM_SECRET_ACCESS_KEY"

# Transactional Email (Resend / AWS SES)
EMAIL_PROVIDER=resend
RESEND_API_KEY="re_PRODUCTION_API_KEY_HERE"
EMAIL_FROM="NEXORA Concierge <concierge@nexoracommerce.com>"
